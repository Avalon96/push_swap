#include "push_swap.h"

void	swap(t_stack *stack)
{
	t_dll	* const first = stack->head;
	t_dll	* const second = first->next;

	second->next->prev = first;
	second->prev = first->prev;
	first->next = second->next;
	first->prev->next = second;

	first->prev = second;
	second->next = first;

	stack->head = second;
}

